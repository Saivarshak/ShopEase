DJANGO_ENV=production
IS_PRODUCTION=true
DEBUG=false
SECRET_KEY=replace-with-a-secure-secret-key
APP_BASE_URL=https://your-app-name.onrender.com
DATABASE_URL=
DB_CONN_MAX_AGE=600
DATABASE_SSL_REQUIRE=false
DB_ENGINE=django.db.backends.postgresql
DB_NAME=EcommerceDb
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
ALLOWED_HOSTS=127.0.0.1,localhost,your-public-domain.com
CSRF_TRUSTED_ORIGINS=https://your-public-domain.com
USE_X_FORWARDED_HOST=true
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_CONTENT_TYPE_NOSNIFF=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

RAZORPAY_MODE=live
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
PAYMENT_CALLBACK_BASE_URL=https://your-public-domain.com
RAZORPAY_PAYMENT_LINK_OVERRIDE_URL=
RAZORPAY_PAYMENT_HANDLE_URL=https://razorpay.me/@yourhandle
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=your_email@example.com
