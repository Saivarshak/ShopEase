# Copy this file to .env and replace every placeholder before running Docker.
# .env is intentionally ignored by Git.

# Django runtime
DJANGO_ENV=production
IS_PRODUCTION=true
DEBUG=false
SECRET_KEY=replace-with-a-long-random-django-secret-key
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Local Docker Compose database. The web container connects to the `db`
# service; it never uses localhost for its PostgreSQL connection.
POSTGRES_DB=shopease
POSTGRES_USER=shopease
POSTGRES_PASSWORD=replace-with-a-long-unique-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=
DATABASE_SSL_REQUIRE=false
DB_CONN_MAX_AGE=600

# Docker Compose binds this port on the host. It is not the PostgreSQL port.
WEB_PORT=8000

# Public URL and host security. Compose overrides these values with local HTTP
# equivalents; set the real HTTPS values when deploying outside Compose.
APP_BASE_URL=https://shop.example.com
PAYMENT_CALLBACK_BASE_URL=https://shop.example.com
ALLOWED_HOSTS=shop.example.com,www.shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com
CORS_ALLOWED_ORIGINS=
TRUST_X_FORWARDED_PROTO=true
USE_X_FORWARDED_HOST=true
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Enable only after every subdomain is HTTPS-ready.
SECURE_HSTS_PRELOAD=false

# Container startup and Gunicorn
RUN_MIGRATIONS=true
COLLECT_STATIC=true
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEP_ALIVE=5

# Uploads and application integrations
MAX_UPLOAD_IMAGE_BYTES=10485760
SHOP_ADMIN_EMAIL=admin@shop.example.com

# Keep payment mode in test until live credentials and webhook verification are
# complete. Do not commit actual Razorpay credentials.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_LINK_OVERRIDE_URL=
RAZORPAY_PAYMENT_HANDLE_URL=

# Email is console-only by default. Configure SMTP only when the provider and
# credentials are ready.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@shop.example.com

# Optional Google OAuth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
